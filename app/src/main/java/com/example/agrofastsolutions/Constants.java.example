package com.example.agrofastsolutions;

/**
 * Template for Constants.java
 *
 * SETUP INSTRUCTIONS:
 * 1. Copy this file and rename it to "Constants.java" (same folder)
 * 2. Replace the placeholder values with your Supabase project credentials
 * 3. Get them from: Supabase Dashboard → Settings → API
 *
 * ⚠️ NEVER commit the real Constants.java file to git
 * ⚠️ Constants.java is listed in .gitignore to prevent accidental commits
 */
public class Constants {

    // Your Supabase project URL
    // Example format: https://abcdefghijklmnop.supabase.co
    public static final String SUPABASE_URL = "YOUR_SUPABASE_URL_HERE";

    // Your Supabase anon (publishable) key
    // Get from: Supabase → Settings → API
    public static final String SUPABASE_ANON_KEY = "YOUR_ANON_KEY_HERE";
}