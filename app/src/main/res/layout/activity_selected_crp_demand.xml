<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F5"
    android:padding="16dp"
    tools:context=".Selected_crp_demand">

    <!-- 1. Header Title Text -->
    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:text="Maize"
        android:textColor="#1B4D3E"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- 2. Price Range FrameLayout (Card container showing Min & Max price range) -->
    <FrameLayout
        android:id="@+id/framePriceRange"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvHeaderTitle"
        android:layout_marginTop="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvPriceRangeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estimated Price Range"
                    android:textColor="#8D6E63"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Price values layout displaying Min and Max -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- Min Price Box -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="#EFEBE9"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Min Price"
                            android:textColor="#5D4037"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvMinPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tsh2300/kg"
                            android:textColor="#1B4D3E"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <!-- Max Price Box -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="#EFEBE9"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Max Price"
                            android:textColor="#5D4037"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvMaxPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tsh2600/kg"
                            android:textColor="#1B4D3E"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Range Slider for dynamic price adjustment -->
                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/priceRangeSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:valueFrom="0.0"
                    android:valueTo="100.0"
                    app:haloColor="#332E7D32"
                    app:thumbColor="#5D4037"
                    app:trackColorActive="#2E7D32"
                    app:trackColorInactive="#D7CCC8" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <!-- 3. High Demand Tag / Status Text -->
    <TextView
        android:id="@+id/tvHighDemandStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/framePriceRange"
        android:layout_marginTop="16dp"
        android:background="#E8F5E9"
        android:drawableStart="@android:drawable/stat_sys_upload"
        android:drawablePadding="6dp"
        android:drawableTint="#2E7D32"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="HIGH DEMAND MARKET"
        android:textColor="#2E7D32"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- 4. Volume Approximated Required by Customer -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardVolumeRequired"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvHighDemandStatus"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvVolumeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="Approximated Volume Required"
                android:textColor="#5D4037"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVolumeSubtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvVolumeLabel"
                android:layout_marginTop="4dp"
                android:text="Based on current aggregated customer orders"
                android:textColor="#757575"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvVolumeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvVolumeSubtext"
                android:layout_marginTop="10dp"
                android:text="12,500 Metric Tons"
                android:textColor="#1B4D3E"
                android:textSize="20sp"
                android:textStyle="bold" />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>



    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitDemand"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_below="@id/cardVolumeRequired"
        android:layout_marginTop="24dp"
        android:text="Place Order"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#1B4D3E"
        app:cornerRadius="12dp"
        app:rippleColor="#8D6E63"
        />

</RelativeLayout>