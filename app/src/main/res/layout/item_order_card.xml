<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorPrimary"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <ImageView
            android:id="@+id/imgOrderCrop"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            app:tint="?attr/colorOnPrimary" />

        <TextView
            android:id="@+id/tvOrderCropType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_toEndOf="@id/imgOrderCrop"
            android:text="Crop Name"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOrderBuyer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvOrderCropType"
            android:layout_marginStart="14dp"
            android:layout_marginTop="2dp"
            android:layout_toEndOf="@id/imgOrderCrop"
            android:text="Buyer: Name"
            android:textColor="?attr/colorOnPrimary"
            android:alpha="0.85"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvOrderSeller"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvOrderBuyer"
            android:layout_marginStart="14dp"
            android:layout_marginTop="2dp"
            android:layout_toEndOf="@id/imgOrderCrop"
            android:text="Seller: Name"
            android:textColor="?attr/colorOnPrimary"
            android:alpha="0.85"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvOrderQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvOrderSeller"
            android:layout_marginStart="14dp"
            android:layout_marginTop="2dp"
            android:layout_toEndOf="@id/imgOrderCrop"
            android:text="Qty: 200kg"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Contact pill — translucent white/black for depth on the card -->
        <TextView
            android:id="@+id/tvOrderContact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvOrderQuantity"
            android:layout_marginStart="14dp"
            android:layout_marginTop="6dp"
            android:layout_toEndOf="@id/imgOrderCrop"
            android:background="#33FFFFFF"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="🛒 Buyer:\n🌾 Seller:"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp" />

        <!-- Decline info — error-tinted pill, uses black/white for contrast -->
        <TextView
            android:id="@+id/tvDeclineInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvOrderContact"
            android:layout_marginStart="14dp"
            android:layout_marginTop="6dp"
            android:layout_toEndOf="@id/imgOrderCrop"
            android:background="#33FF0000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp"
            android:visibility="gone"
            android:text="Reason: —\nFee: —" />

        <TextView
            android:id="@+id/tvGraceInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvDeclineInfo"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:layout_toEndOf="@id/imgOrderCrop"
            android:background="#33FFFFFF"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:text="✅ No fee — declined within 24h grace period" />

        <!-- Action buttons — invert colors so they contrast against the card -->
        <LinearLayout
            android:id="@+id/orderActionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvOrderContact"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:visibility="gone"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettle"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="Mark Settled"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="?attr/colorOnPrimary"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeclineOrder"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Decline"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:strokeColor="?attr/colorOnPrimary" />

        </LinearLayout>

        <!-- Status pill — invert for contrast -->
        <TextView
            android:id="@+id/tvOrderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:background="#33FFFFFF"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="CONFIRMED"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOrderPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/tvOrderStatus"
            android:layout_marginTop="16dp"
            android:text="$3,450.00"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOrderNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/tvOrderPrice"
            android:layout_marginTop="4dp"
            android:text="Note"
            android:textColor="?attr/colorOnPrimary"
            android:alpha="0.7"
            android:textSize="10sp" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>